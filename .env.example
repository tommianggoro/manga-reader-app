# Kunci rahasia agar register.php tidak bisa dipakai sembarang orang.
# Isi dengan string acak untuk MENGAKTIFKAN pendaftaran akun baru.
# Kosongkan untuk MENONAKTIFKAN pendaftaran sepenuhnya.
REGISTRATION_SECRET_KEY=

# Token bot Telegram (dari @BotFather), dipakai server-side utk kirim notif
# bookmark personal per-user. BEDA dari secret TELEGRAM_BOT_TOKEN di GitHub
