DB_HOST=localhost
DB_NAME=manga_reader
DB_USER=root
DB_PASS=

# Generate lewat generate_password_hash.php?pw=passwordbarumu, lalu hapus file itu dari server
ACCESS_PASSWORD_HASH=

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Ganti dengan string acak sendiri, dipakai untuk otentikasi GitHub Actions cron
CRON_SECRET_KEY=

# Kunci rahasia agar register.php tidak bisa dipakai sembarang orang.
# Isi dengan string acak untuk MENGAKTIFKAN pendaftaran akun baru.
# Kosongkan untuk MENONAKTIFKAN pendaftaran sepenuhnya.
REGISTRATION_SECRET_KEY=